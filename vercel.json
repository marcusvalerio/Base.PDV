{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/src/migrations/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/conheca",
      "destination": "/conheca/index.html"
    },
    {
      "source": "/((?!assets/|conheca/).*)",
      "destination": "/index.html"
    }
  ]
}
