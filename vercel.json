{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/src/migrations/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/central",
      "destination": "/app.html"
    },
    {
      "source": "/central/(.*)",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/conheca",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:p(mesas|fiado|caixa|inventario|admin)/:rest*",
      "destination": "/app/:p/:rest*",
      "permanent": false
    },
    {
      "source": "/:p(mesas|fiado|caixa|inventario|admin)",
      "destination": "/app/:p",
      "permanent": false
    }
  ]
}
