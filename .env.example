# String de conexão do Neon (Dashboard do Neon > projeto central-pdv > Connect). Nunca faça commit dela.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.sa-east-1.aws.neon.tech/pdv?sslmode=require
# Conexões simultâneas por instância do servidor
DB_POOL_MAX=10
# Token para criar o primeiro administrador central em /central (só funciona enquanto não existir nenhum).
SETUP_TOKEN=troque-por-um-texto-longo-e-aleatorio
PORT=3001
BUSINESS_TZ=America/Sao_Paulo
# Na Vercel (HTTPS) o padrão é cookie seguro; use false apenas em desenvolvimento local sem HTTPS.
COOKIE_SECURE=false
# Endereço público do site (volta do pagamento do Stripe)
APP_URL=https://centralpdv.vercel.app
# Assinatura (Stripe). Sem elas, use estabelecimentos isentos ou em teste.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_SETUP_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
